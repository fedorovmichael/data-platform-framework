{
  "name": "user_pipeline",
  "runtime": { "type": "spark" },
  "enabled": true,
  "source": {
    "type": "csv_spark",
    "options": {
      "path": "data/users.csv"
    }
  },
  "validators": [
    { "type": "spark_username_null_empty" },
    { "type": "spark_email_null_empty" }
  ],
  "transformation": { "type": "spark_user_composit_transformer" },
  "sink": {
    "type": "parquet",
    "options": {
      "path": "data/output/users.parquet"
    }
  }
}
